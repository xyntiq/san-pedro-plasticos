---
import { Image } from 'astro:assets';
import Container from './Container.astro';
import Button from './Button.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import ganchosImg from '../assets/productos/ganchos-ropa-colores/principal.png';
import colgadorImg from '../assets/productos/colgador-clasico-reforzado/principal.jpg';
import munecosImg from '../assets/productos/munecos-llavero-plastico/principal.avif';
---

<section class="relative overflow-hidden bg-hero-gradient text-white">
  <!-- Patrón técnico industrial sutil -->
  <div
    class="pointer-events-none absolute inset-0 bg-industrial-grid bg-[size:40px_40px] opacity-60"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute -top-32 -right-32 h-96 w-96 rounded-full bg-brand-accent/20 blur-3xl"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute -bottom-24 -left-24 h-80 w-80 rounded-full bg-brand-secondary/30 blur-3xl"
    aria-hidden="true"
  ></div>

  <Container class="relative z-10 py-14 sm:py-20 lg:py-24">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-10">
      <!-- Columna izquierda: Propuesta de valor comercial -->
      <div class="lg:col-span-7 space-y-6 text-left">
        <div class="inline-flex items-center gap-2.5 rounded-full bg-white/10 border border-white/20 backdrop-blur-md px-4 py-1.5 text-xs sm:text-sm font-semibold text-white">
          <span class="flex h-2 w-2 rounded-full bg-brand-accent" aria-hidden="true"></span>
          <span>Fábrica directa de productos plásticos</span>
        </div>

        <h1 class="font-display text-3xl sm:text-5xl lg:text-[3.35rem] font-extrabold tracking-tight leading-[1.12] text-white">
          Productos plásticos <span class="text-brand-accent-light">directo de fábrica</span> para tu negocio
        </h1>

        <p class="max-w-2xl text-base sm:text-lg lg:text-xl text-slate-200 leading-relaxed">
          Ganchos, colgadores y llaveros plásticos pensados para comercios, mayoristas y clientes que buscan calidad, variedad y atención rápida.
        </p>

        <!-- CTAs principales -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-2">
          <WhatsAppButton
            label="Solicitar cotización"
            preset="mayorista"
            location="hero"
            variant="primary"
            size="lg"
          />
          <Button href="/catalogo" variant="outline-light" size="lg">
            <span>Ver catálogo completo</span>
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </Button>
        </div>

        <!-- Mini pruebas de confianza -->
        <div class="pt-4 border-t border-white/15 grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs sm:text-sm text-slate-200">
          <div class="flex items-center gap-2.5">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-400/30">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <span class="font-medium">Venta mayorista y minorista</span>
          </div>
          <div class="flex items-center gap-2.5">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-400/30">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <span class="font-medium">Atención personalizada</span>
          </div>
          <div class="flex items-center gap-2.5">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-400/30">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <span class="font-medium">Productos resistentes</span>
          </div>
        </div>
      </div>

      <!-- Columna derecha: Composición visual Glassmorphism -->
      <div class="lg:col-span-5">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <!-- Card principal flotante -->
          <div class="relative rounded-3xl bg-white/10 p-3 sm:p-4 backdrop-blur-md border border-white/20 shadow-2xl animate-float">
            <div class="rounded-2xl bg-white p-5 sm:p-6 shadow-inner">
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-primary/10 px-3 py-1 text-xs font-bold text-brand-primary">
                  Producción Directa
                </span>
                <span class="font-mono text-xs font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
                  ● Disponible por volumen
                </span>
              </div>

              <a href="/producto/ganchos-ropa-colores" class="block group">
                <div class="aspect-[4/3] w-full overflow-hidden rounded-xl bg-white flex items-center justify-center p-2">
                  <Image
                    src={ganchosImg}
                    alt="Ganchos de ropa plásticos x 24 unidades fabricados por San Pedro Plásticos"
                    width={640}
                    height={480}
                    loading="eager"
                    fetchpriority="high"
                    class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105"
                  />
                </div>
                <div class="mt-3 flex items-center justify-between">
                  <div>
                    <p class="font-display text-base font-extrabold text-brand-text group-hover:text-brand-primary transition-colors">
                      Ganchos Plásticos x 24 Und.
                    </p>
                    <p class="text-xs text-brand-muted">
                      Alta rotación en bazares y comercios
                    </p>
                  </div>
                  <span class="rounded-xl bg-brand-bg px-3 py-1.5 font-display text-xs font-bold text-brand-primary group-hover:bg-brand-accent group-hover:text-white transition-colors">
                    Ver ficha →
                  </span>
                </div>
              </a>
            </div>

            <!-- Mini cards secundarias superpuestas -->
            <div class="mt-3 grid grid-cols-2 gap-3">
              <a
                href="/producto/colgador-clasico-reforzado"
                class="group flex items-center gap-3 rounded-2xl bg-white/95 p-3 shadow-md transition-transform hover:-translate-y-0.5"
              >
                <div class="h-12 w-12 shrink-0 rounded-xl bg-brand-bg p-1.5 flex items-center justify-center">
                  <Image
                    src={colgadorImg}
                    alt="Colgador plástico reforzado San Pedro Plásticos"
                    width={120}
                    height={120}
                    loading="eager"
                    class="h-full w-full object-contain"
                  />
                </div>
                <div class="min-w-0">
                  <p class="truncate font-display text-xs font-bold text-brand-text group-hover:text-brand-primary">
                    Colgadores
                  </p>
                  <p class="text-[11px] text-brand-muted truncate">
                    Perchas reforzadas
                  </p>
                </div>
              </a>

              <a
                href="/producto/munecos-llavero-plastico"
                class="group flex items-center gap-3 rounded-2xl bg-white/95 p-3 shadow-md transition-transform hover:-translate-y-0.5"
              >
                <div class="h-12 w-12 shrink-0 rounded-xl bg-brand-bg p-1.5 flex items-center justify-center">
                  <Image
                    src={munecosImg}
                    alt="Muñecos plásticos tipo llavero San Pedro Plásticos"
                    width={120}
                    height={120}
                    loading="eager"
                    class="h-full w-full object-contain"
                  />
                </div>
                <div class="min-w-0">
                  <p class="truncate font-display text-xs font-bold text-brand-text group-hover:text-brand-primary">
                    Llaveros
                  </p>
                  <p class="text-[11px] text-brand-muted truncate">
                    Muñecos por cantidad
                  </p>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

