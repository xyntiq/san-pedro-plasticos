---
import Container from './Container.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { SITE_CONFIG } from '../config/site';

const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/catalogo', label: 'Catálogo' },
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/contacto', label: 'Contacto' },
];

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<header
  id="site-header"
  class="sticky top-0 z-40 w-full border-b border-brand-border/80 bg-white/90 backdrop-blur-md transition-shadow duration-200"
>
  <Container class="flex h-20 items-center justify-between gap-4">
    <!-- Brand Logo -->
    <a
      href="/"
      class="group flex items-center gap-3 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-primary"
      aria-label={`${SITE_CONFIG.nombreEmpresa} - Ir al inicio`}
    >
      <div
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-hero-gradient text-white shadow-soft transition-transform duration-200 group-hover:scale-105"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M4 17L12 6L20 17H4Z"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linejoin="round"
          />
          <path
            d="M3 20.5H21"
            stroke="#FF8C42"
            stroke-width="2.5"
            stroke-linecap="round"
          />
          <circle cx="12" cy="3.5" r="1.5" fill="#FF8C42" />
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="font-display text-lg font-extrabold tracking-tight text-brand-primary leading-none">
          SAN PEDRO
        </span>
        <span class="font-mono text-[11px] font-bold tracking-[0.22em] text-brand-secondary mt-1">
          PLÁSTICOS
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav aria-label="Navegación principal" class="hidden md:flex items-center gap-1 lg:gap-2">
      {
        navLinks.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={link.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'rounded-lg px-3.5 py-2 text-sm font-medium transition-colors',
                active
                  ? 'bg-brand-primary/10 text-brand-primary font-semibold'
                  : 'text-brand-text/80 hover:text-brand-primary hover:bg-brand-bg',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Desktop CTA -->
    <div class="hidden md:flex items-center gap-3">
      <WhatsAppButton
        label="Cotizar por WhatsApp"
        preset="mayorista"
        location="header"
        variant="primary"
        size="sm"
      />
    </div>

    <!-- Mobile Menu Toggle -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="inline-flex md:hidden items-center justify-center rounded-xl p-2.5 text-brand-primary hover:bg-brand-bg focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand-primary"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú de navegación"
    >
      <svg
        id="icon-menu-open"
        class="h-6 w-6"
         fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg
        id="icon-menu-close"
        class="hidden h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </Container>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-brand-border bg-white px-4 pt-3 pb-6 shadow-lg"
  >
    <nav aria-label="Navegación móvil" class="flex flex-col space-y-1.5">
      {
        navLinks.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={link.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'rounded-xl px-4 py-3 text-base font-medium transition-colors',
                active
                  ? 'bg-brand-primary/10 text-brand-primary font-bold'
                  : 'text-brand-text hover:bg-brand-bg',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
      <div class="pt-3 border-t border-brand-border mt-2">
        <p class="px-2 pb-2 text-xs font-semibold uppercase tracking-wider text-brand-muted">
          Categorías directas
        </p>
        <div class="grid grid-cols-3 gap-2 pb-4">
          {
            SITE_CONFIG.categorias.map((cat) => (
              <a
                href={`/categoria/${cat.slug}`}
                class="rounded-lg bg-brand-bg px-3 py-2 text-center text-xs font-semibold text-brand-primary hover:bg-brand-secondary/15"
              >
                {cat.nombreCorto}
              </a>
            ))
          }
        </div>
        <WhatsAppButton
          label="Cotizar por WhatsApp"
          preset="mayorista"
          location="header"
          variant="primary"
          size="md"
          fullWidth={true}
        />
      </div>
    </nav>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-menu-open');
  const iconClose = document.getElementById('icon-menu-close');
  const header = document.getElementById('site-header');

  if (menuBtn && mobileMenu && iconOpen && iconClose) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', String(!isExpanded));
      menuBtn.setAttribute(
        'aria-label',
        !isExpanded ? 'Cerrar menú de navegación' : 'Abrir menú de navegación'
      );
      mobileMenu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }

  if (header) {
    window.addEventListener(
      'scroll',
      () => {
        if (window.scrollY > 12) {
          header.classList.add('shadow-soft');
        } else {
          header.classList.remove('shadow-soft');
        }
      },
      { passive: true }
    );
  }
</script>

