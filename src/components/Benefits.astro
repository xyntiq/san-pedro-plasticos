---
import Container from './Container.astro';
import SectionHeading from './SectionHeading.astro';
import Reveal from './Reveal.astro';

const benefits = [
  {
    title: 'Compra directa de fábrica',
    description:
      'Trato directo sin intermediarios. Obtenés precios competitivos para revender con mejor margen en tu comercio o distribuidora.',
    icon: 'factory',
  },
  {
    title: 'Productos resistentes para uso diario',
    description:
      'Inyección plástica cuidada con materiales durables, buena terminación y colores firmes pensados para soportar la manipulación cotidiana.',
    icon: 'shield',
  },
  {
    title: 'Venta mayorista y minorista',
    description:
      'Nos adaptamos a la escala de tu pedido: desde packs para comercios y emprendedores hasta abastecimiento por volumen para mayoristas.',
    icon: 'boxes',
  },
  {
    title: 'Atención rápida por WhatsApp',
    description:
      'Consultá stock, surtido de colores y cotizaciones por cantidad en minutos hablando directamente con nuestro equipo comercial.',
    icon: 'whatsapp',
  },
];
---

<section class="py-16 sm:py-20 lg:py-24 bg-white border-b border-brand-border/70">
  <Container>
    <Reveal>
      <SectionHeading
        eyebrow="Ventajas competitivas"
        title="¿Por qué comprar en San Pedro Plásticos?"
        description="Combinamos producción propia, artículos de alta rotación comercial y una atención ágil para que abastecer tu negocio sea simple y rentable."
      />
    </Reveal>

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        benefits.map((item, idx) => (
          <Reveal delay={idx * 80}>
            <div class="group h-full rounded-2xl bg-brand-bg/70 p-6 sm:p-7 border border-brand-border transition-all duration-300 hover:-translate-y-1.5 hover:bg-white hover:shadow-elevated hover:border-brand-secondary/40">
              <div class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-brand-primary text-white shadow-soft transition-colors group-hover:bg-brand-accent">
                {item.icon === 'factory' && (
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                )}
                {item.icon === 'shield' && (
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                )}
                {item.icon === 'boxes' && (
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                  </svg>
                )}
                {item.icon === 'whatsapp' && (
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                )}
              </div>

              <h3 class="font-display text-lg font-bold text-brand-text group-hover:text-brand-primary transition-colors">
                {item.title}
              </h3>
              <p class="mt-2.5 text-sm text-brand-muted leading-relaxed">
                {item.description}
              </p>
            </div>
          </Reveal>
        ))
      }
    </div>
  </Container>
</section>

