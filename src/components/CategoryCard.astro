---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CategoryInfo } from '../config/site';

interface Props {
  category: CategoryInfo;
  image: ImageMetadata;
  productCount?: number;
}

const { category, image, productCount } = Astro.props;
---

<a
  href={`/categoria/${category.slug}`}
  class="group relative flex flex-col justify-between overflow-hidden rounded-3xl bg-white border border-brand-border shadow-card transition-all duration-300 hover:-translate-y-1.5 hover:shadow-elevated hover:border-brand-secondary/50"
>
  <!-- Contenedor de imagen -->
  <div class="relative aspect-[16/11] w-full overflow-hidden bg-gradient-to-b from-brand-bg/60 to-white p-6 flex items-center justify-center">
    <div class="absolute top-4 left-4 z-10">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-primary/10 px-3 py-1 text-xs font-bold text-brand-primary">
        Fábrica directa
      </span>
    </div>
    {
      typeof productCount === 'number' && (
        <div class="absolute top-4 right-4 z-10">
          <span class="rounded-full bg-white/90 border border-brand-border px-2.5 py-1 text-xs font-mono font-semibold text-brand-muted">
            {productCount} {productCount === 1 ? 'línea' : 'líneas'}
          </span>
        </div>
      )
    }
    <Image
      src={image}
      alt={`${category.nombre} fabricados por San Pedro Plásticos`}
      width={600}
      height={420}
      loading="lazy"
      class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-108"
    />
  </div>

  <!-- Info de categoría -->
  <div class="flex flex-1 flex-col justify-between p-6 sm:p-7 bg-white border-t border-brand-border/60">
    <div>
      <h3 class="font-display text-xl sm:text-2xl font-extrabold text-brand-text group-hover:text-brand-primary transition-colors">
        {category.nombre}
      </h3>
      <p class="mt-2 text-sm text-brand-muted leading-relaxed">
        {category.descripcion}
      </p>
    </div>

    <div class="mt-5 pt-4 border-t border-brand-border/60 flex items-center justify-between">
      <span class="text-xs font-medium text-brand-secondary">
        {category.beneficioClave}
      </span>
      <span class="inline-flex items-center gap-1.5 font-display text-sm font-bold text-brand-accent group-hover:translate-x-1 transition-transform shrink-0 ml-2">
        Ver productos
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </span>
    </div>
  </div>
</a>

