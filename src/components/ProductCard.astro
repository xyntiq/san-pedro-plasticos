---
import { Image } from 'astro:assets';
import type { ProductoEntry } from '../utils/products';
import { CATEGORY_LABELS, COLOR_SWATCH_MAP, STOCK_CONFIG } from '../utils/slug';
import WhatsAppButton from './WhatsAppButton.astro';

interface Props {
  product: ProductoEntry;
  priority?: boolean;
}

const { product, priority = false } = Astro.props;
const {
  slug,
  nombre,
  categoria,
  descripcionCorta,
  imagenes,
  especificaciones,
  sku,
  stock,
  colores,
} = product.data;

const mainImage = imagenes[0];
const stockInfo = STOCK_CONFIG[stock];
const categoryLabel = CATEGORY_LABELS[categoria];
---

<article
  class="group relative flex flex-col rounded-2xl bg-white border border-brand-border/90 shadow-card transition-all duration-300 hover:-translate-y-1.5 hover:shadow-elevated hover:border-brand-secondary/40 overflow-hidden"
  data-category={categoria}
  data-name={nombre.toLowerCase()}
  data-sku={sku.toLowerCase()}
>
  <!-- Imagen del producto -->
  <a
    href={`/producto/${slug}`}
    class="relative block aspect-[4/3] w-full overflow-hidden bg-white p-6 border-b border-brand-border/60"
    aria-label={`Ver ficha técnica de ${nombre}`}
  >
    <!-- Badges superiores -->
    <div class="absolute top-3.5 left-3.5 right-3.5 z-10 flex items-center justify-between gap-2">
      <span class="rounded-lg bg-brand-primary/90 backdrop-blur-sm px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider text-white">
        {categoryLabel}
      </span>
      <span
        class:list={[
          'inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-semibold',
          stockInfo.badgeClass,
        ]}
      >
        <span class:list={['h-1.5 w-1.5 rounded-full', stockInfo.dotClass]} aria-hidden="true" />
        {stockInfo.label}
      </span>
    </div>

    <Image
      src={mainImage}
      alt={`${nombre} fabricado por San Pedro Plásticos`}
      width={640}
      height={480}
      loading={priority ? 'eager' : 'lazy'}
      decoding={priority ? 'sync' : 'async'}
      class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105"
    />
  </a>

  <!-- Contenido -->
  <div class="flex flex-1 flex-col justify-between p-5 sm:p-6">
    <div>
      <div class="flex items-center justify-between gap-2 text-xs text-brand-muted mb-1.5">
        <span class="font-mono font-medium">SKU: {sku}</span>
        <span class="truncate max-w-[180px]" title={especificaciones.material}>
          {especificaciones.material.split('+')[0]}
        </span>
      </div>

      <h3 class="font-display text-lg sm:text-xl font-bold text-brand-text group-hover:text-brand-primary transition-colors">
        <a href={`/producto/${slug}`} class="focus-visible:outline-none">
          {nombre}
        </a>
      </h3>

      <p class="mt-2 text-sm text-brand-muted line-clamp-2 leading-relaxed">
        {descripcionCorta}
      </p>

      <!-- Colores disponibles -->
      {
        colores && colores.length > 0 && (
          <div class="mt-4 flex items-center gap-2 flex-wrap">
            <span class="text-xs font-semibold text-brand-text/80">Colores:</span>
            <div class="flex items-center gap-1.5 flex-wrap">
              {colores.map((color) => {
                const bg = COLOR_SWATCH_MAP[color] || '#9CA3AF';
                return (
                  <span
                    class="inline-flex items-center gap-1 rounded-md bg-brand-bg px-2 py-0.5 text-[11px] font-medium text-brand-text border border-brand-border"
                    title={`Color: ${color}`}
                  >
                    <span
                      class="h-2.5 w-2.5 rounded-full border border-black/15 shrink-0"
                      style={`background: ${bg};`}
                      aria-hidden="true"
                    />
                    {color}
                  </span>
                );
              })}
            </div>
          </div>
        )
      }
    </div>

    <!-- Botones de acción -->
    <div class="mt-6 pt-4 border-t border-brand-border/80 grid grid-cols-2 gap-2.5">
      <a
        href={`/producto/${slug}`}
        class="inline-flex items-center justify-center rounded-xl border border-brand-border bg-brand-bg/70 px-3.5 py-2.5 font-display text-xs sm:text-sm font-semibold text-brand-primary transition-colors hover:bg-brand-primary hover:text-white hover:border-brand-primary"
      >
        Ver detalle
      </a>
      <WhatsAppButton
        label="Consultar"
        preset="producto"
        productName={nombre}
        productSku={sku}
        location="card"
        variant="whatsapp"
        size="sm"
        fullWidth={true}
      />
    </div>
  </div>
</article>

