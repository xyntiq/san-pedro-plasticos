---
import Container from './Container.astro';
import { SITE_CONFIG } from '../config/site';
import { buildWhatsAppUrl, getGeneralWhatsAppMessage } from '../utils/whatsapp';

const currentYear = new Date().getFullYear();
const waUrl = buildWhatsAppUrl(getGeneralWhatsAppMessage());
---

<footer class="bg-[#07374B] text-slate-300 border-t border-white/10">
  <Container class="py-14 lg:py-16">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-12">
      <!-- Columna 1: Marca -->
      <div class="lg:col-span-4 space-y-4">
        <a href="/" class="inline-flex items-center gap-3 text-white">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 border border-white/20">
            <svg class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M4 17L12 6L20 17H4Z"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linejoin="round"
              />
              <path
                d="M3 20.5H21"
                stroke="#FF8C42"
                stroke-width="2.5"
                stroke-linecap="round"
              />
            </svg>
          </div>
          <div>
            <span class="block font-display text-lg font-extrabold tracking-tight text-white leading-none">
              SAN PEDRO
            </span>
            <span class="block font-mono text-[10px] font-bold tracking-[0.22em] text-brand-accent-light mt-1">
              PLÁSTICOS
            </span>
          </div>
        </a>
        <p class="text-sm text-slate-300 leading-relaxed max-w-sm">
          Fábrica directa de productos plásticos pensados para el uso diario y la venta comercial. Abastecemos bazares, tiendas de ropa, mayoristas y distribuidores con atención ágil y personalizada.
        </p>
        <div class="inline-flex items-center gap-2 rounded-full bg-white/5 border border-white/10 px-3.5 py-1.5 text-xs font-medium text-slate-200">
          <span class="h-2 w-2 rounded-full bg-emerald-400" aria-hidden="true"></span>
          Producción directa · Venta mayorista y minorista
        </div>
      </div>

      <!-- Columna 2: Navegación -->
      <div class="lg:col-span-2 space-y-3">
        <h3 class="font-display text-sm font-bold uppercase tracking-wider text-white">
          Navegación
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="/" class="hover:text-white transition-colors">Inicio</a>
          </li>
          <li>
            <a href="/catalogo" class="hover:text-white transition-colors">Catálogo completo</a>
          </li>
          <li>
            <a href="/nosotros" class="hover:text-white transition-colors">Sobre la fábrica</a>
          </li>
          <li>
            <a href="/contacto" class="hover:text-white transition-colors">Solicitar cotización</a>
          </li>
        </ul>
      </div>

      <!-- Columna 3: Categorías -->
      <div class="lg:col-span-3 space-y-3">
        <h3 class="font-display text-sm font-bold uppercase tracking-wider text-white">
          Líneas de Productos
        </h3>
        <ul class="space-y-2.5 text-sm">
          {
            SITE_CONFIG.categorias.map((cat) => (
              <li>
                <a
                  href={`/categoria/${cat.slug}`}
                  class="hover:text-white transition-colors flex items-center gap-2"
                >
                  <span class="h-1.5 w-1.5 rounded-full bg-brand-accent" aria-hidden="true" />
                  {cat.nombre}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Columna 4: Contacto Directo -->
      <div class="lg:col-span-3 space-y-3">
        <h3 class="font-display text-sm font-bold uppercase tracking-wider text-white">
          Atención Comercial
        </h3>
        <ul class="space-y-3 text-sm">
          <li class="flex items-start gap-2.5">
            <svg class="h-5 w-5 text-brand-accent-light shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
            <div>
              <span class="block text-xs text-slate-400">WhatsApp Ventas</span>
              <a
                href={waUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="font-semibold text-white hover:text-brand-accent-light transition-colors"
              >
                {SITE_CONFIG.whatsappDisplay} (Consultar ahora)
              </a>
            </div>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="h-5 w-5 text-brand-accent-light shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <div>
              <span class="block text-xs text-slate-400">Correo electrónico</span>
              <a
                href={`mailto:${SITE_CONFIG.email}`}
                class="font-medium text-white hover:text-brand-accent-light transition-colors break-all"
              >
                {SITE_CONFIG.email}
              </a>
            </div>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="h-5 w-5 text-brand-accent-light shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <div>
              <span class="block text-xs text-slate-400">Ubicación</span>
              <span class="text-slate-200">
                {SITE_CONFIG.direccion}, {SITE_CONFIG.ciudad}
              </span>
            </div>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p>
        © {currentYear} {SITE_CONFIG.nombreEmpresa}. Todos los derechos reservados.
      </p>
      <p>
        Fábrica de ganchos, colgadores y productos plásticos · Atención mayorista y minorista.
      </p>
    </div>
  </Container>
</footer>

