---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import ProductLayout from '../../layouts/ProductLayout.astro';
import Container from '../../components/Container.astro';
import Button from '../../components/Button.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import ProductCard from '../../components/ProductCard.astro';
import Reveal from '../../components/Reveal.astro';
import { getAllProducts, getRelatedProducts, type ProductoEntry } from '../../utils/products';
import { CATEGORY_LABELS, COLOR_SWATCH_MAP, STOCK_CONFIG } from '../../utils/slug';

export async function getStaticPaths() {
  const productos = await getAllProducts();
  return productos.map((product) => ({
    params: { slug: product.data.slug },
    props: { product },
  }));
}

interface Props {
  product: ProductoEntry;
}

const { product } = Astro.props;
const {
  slug,
  nombre,
  categoria,
  descripcionCorta,
  descripcionLarga,
  imagenes,
  especificaciones,
  beneficios,
  sku,
  precio,
  stock,
  colores,
} = product.data;

const { Content } = await render(product);
const relatedProducts = await getRelatedProducts(slug, categoria, 3);
const categoryLabel = CATEGORY_LABELS[categoria];
const stockInfo = STOCK_CONFIG[stock];

// Mensaje exacto solicitado en la sección 9 del Prompt Maestro
const fichaWhatsAppMessage = `Hola, quiero consultar por el producto ${nombre} - SKU ${sku}. ¿Me pasás precio y disponibilidad?`;
const mayoristaWhatsAppMessage = `Hola, quiero solicitar una cotización por cantidad del producto ${nombre} - SKU ${sku}. ¿Me informás precios mayoristas, colores disponibles y venta mínima?`;
---

<ProductLayout product={product}>
  <section class="py-8 sm:py-12">
    <Container>
      <!-- 1. Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-6 text-xs sm:text-sm text-brand-muted">
        <ol class="flex flex-wrap items-center gap-2">
          <li>
            <a href="/" class="hover:text-brand-primary transition-colors">Inicio</a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <a href="/catalogo" class="hover:text-brand-primary transition-colors">Catálogo</a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <a
              href={`/categoria/${categoria}`}
              class="hover:text-brand-primary transition-colors"
            >
              {categoryLabel}
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li class="font-semibold text-brand-text truncate max-w-[240px]" aria-current="page">
            {nombre}
          </li>
        </ol>
      </nav>

      <!-- Bloque Principal: Galería + Información Comercial -->
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-start">
        <!-- 2. Galería -->
        <div class="lg:col-span-6 space-y-4">
          <div class="relative overflow-hidden rounded-3xl bg-white border border-brand-border shadow-card p-6 sm:p-10 aspect-[4/3] flex items-center justify-center group">
            <span class="absolute top-4 left-4 rounded-xl bg-brand-primary/10 px-3 py-1 text-xs font-bold text-brand-primary">
              Fábrica Directa
            </span>
            <Image
              id="main-product-image"
              src={imagenes[0]}
              alt={`${nombre} fabricado por San Pedro Plásticos`}
              width={800}
              height={600}
              loading="eager"
              fetchpriority="high"
              class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105"
            />
          </div>

          {
            imagenes.length > 1 && (
              <div class="grid grid-cols-4 gap-3">
                {imagenes.map((img, index) => (
                  <div class="overflow-hidden rounded-2xl bg-white border border-brand-border p-2 aspect-square flex items-center justify-center">
                    <Image
                      src={img}
                      alt={`${nombre} - Vista ${index + 1}`}
                      width={200}
                      height={200}
                      class="h-full w-full object-contain"
                    />
                  </div>
                ))}
              </div>
            )
          }
        </div>

        <!-- 3. Información Principal -->
        <div class="lg:col-span-6 rounded-3xl bg-white p-6 sm:p-8 lg:p-10 border border-brand-border shadow-card space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <a
              href={`/categoria/${categoria}`}
              class="inline-flex items-center rounded-lg bg-brand-secondary/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-brand-primary hover:bg-brand-secondary/20 transition-colors"
            >
              {categoryLabel}
            </a>
            <span
              class:list={[
                'inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-semibold',
                stockInfo.badgeClass,
              ]}
            >
              <span class:list={['h-2 w-2 rounded-full', stockInfo.dotClass]} aria-hidden="true" />
              {stockInfo.label}
            </span>
          </div>

          <div>
            <p class="font-mono text-xs font-bold uppercase tracking-wider text-brand-muted">
              Código SKU: {sku}
            </p>
            <h1 class="mt-1 font-display text-2xl sm:text-3xl lg:text-4xl font-extrabold text-brand-text leading-tight">
              {nombre}
            </h1>
          </div>

          <p class="text-base text-brand-muted leading-relaxed">
            {descripcionCorta}
          </p>

          <!-- Precio / Modalidad -->
          <div class="rounded-2xl bg-brand-bg/90 p-4 border border-brand-border flex items-center justify-between gap-4">
            <div>
              <span class="block text-xs font-semibold uppercase tracking-wider text-brand-muted">
                Modalidad comercial
              </span>
              <span class="font-display text-lg font-extrabold text-brand-primary">
                {
                  precio === 'consultar'
                    ? 'Cotización según volumen (Mayorista y Minorista)'
                    : `$${precio}`
                }
              </span>
            </div>
            <span class="hidden sm:inline-flex rounded-xl bg-white px-3 py-1.5 text-xs font-bold text-brand-secondary border border-brand-border shrink-0">
              Directo de fábrica
            </span>
          </div>

          <!-- Swatches de Colores disponibles -->
          {
            colores && colores.length > 0 && (
              <div>
                <h2 class="text-xs font-bold uppercase tracking-wider text-brand-text mb-2.5">
                  Colores disponibles:
                </h2>
                <div class="flex flex-wrap gap-2">
                  {colores.map((color) => {
                    const bg = COLOR_SWATCH_MAP[color] || '#9CA3AF';
                    return (
                      <span class="inline-flex items-center gap-2 rounded-xl bg-brand-bg px-3 py-1.5 text-xs font-semibold text-brand-text border border-brand-border">
                        <span
                          class="h-3.5 w-3.5 rounded-full border border-black/15 shrink-0"
                          style={`background: ${bg};`}
                          aria-hidden="true"
                        />
                        {color}
                      </span>
                    );
                  })}
                </div>
              </div>
            )
          }

          <!-- CTAs Principales -->
          <div class="pt-2 space-y-3">
            <WhatsAppButton
              label="Solicitar cotización"
              message={mayoristaWhatsAppMessage}
              location="ficha"
              variant="primary"
              size="lg"
              fullWidth={true}
            />
            <WhatsAppButton
              label="Consultar por WhatsApp"
              message={fichaWhatsAppMessage}
              location="ficha"
              variant="whatsapp"
              size="lg"
              fullWidth={true}
            />
          </div>

          <!-- Sellos de garantía comercial -->
          <div class="pt-4 border-t border-brand-border grid grid-cols-2 gap-3 text-xs text-brand-muted">
            <div class="flex items-center gap-2">
              <svg class="h-4 w-4 text-brand-secondary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span>Respuesta rápida a comercios</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="h-4 w-4 text-brand-secondary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span>Precios especiales por cantidad</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 4. Beneficios del Producto -->
      {
        beneficios && beneficios.length > 0 && (
          <div class="mt-14">
            <Reveal>
              <h2 class="font-display text-2xl sm:text-3xl font-extrabold text-brand-text mb-6">
                Beneficios comerciales y de uso
              </h2>
              <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
                {beneficios.map((ben) => (
                  <div class="rounded-2xl bg-white p-6 border border-brand-border shadow-card">
                    <div class="mb-3 inline-flex h-9 w-9 items-center justify-center rounded-xl bg-brand-secondary/15 text-brand-primary">
                      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                    </div>
                    <h3 class="font-display text-lg font-bold text-brand-text">
                      {ben.titulo}
                    </h3>
                    <p class="mt-1.5 text-sm text-brand-muted leading-relaxed">
                      {ben.descripcion}
                    </p>
                  </div>
                ))}
              </div>
            </Reveal>
          </div>
        )
      }

      <!-- 5. Especificaciones Técnicas + 6. Descripción Larga -->
      <div class="mt-14 grid grid-cols-1 gap-10 lg:grid-cols-12">
        <!-- Tabla de Especificaciones Técnicas -->
        <div class="lg:col-span-6">
          <Reveal>
            <div class="rounded-3xl bg-white p-6 sm:p-8 border border-brand-border shadow-card">
              <h2 class="font-display text-xl sm:text-2xl font-extrabold text-brand-text mb-5">
                Especificaciones técnicas
              </h2>
              <dl class="divide-y divide-brand-border text-sm">
                <div class="py-3.5 grid grid-cols-3 gap-4">
                  <dt class="font-semibold text-brand-muted">SKU</dt>
                  <dd class="col-span-2 font-mono font-bold text-brand-text">{sku}</dd>
                </div>
                <div class="py-3.5 grid grid-cols-3 gap-4">
                  <dt class="font-semibold text-brand-muted">Material</dt>
                  <dd class="col-span-2 text-brand-text">{especificaciones.material}</dd>
                </div>
                <div class="py-3.5 grid grid-cols-3 gap-4">
                  <dt class="font-semibold text-brand-muted">Medidas</dt>
                  <dd class="col-span-2 text-brand-text">{especificaciones.medidas}</dd>
                </div>
                <div class="py-3.5 grid grid-cols-3 gap-4">
                  <dt class="font-semibold text-brand-muted">Peso</dt>
                  <dd class="col-span-2 text-brand-text">{especificaciones.peso}</dd>
                </div>
                <div class="py-3.5 grid grid-cols-3 gap-4">
                  <dt class="font-semibold text-brand-muted">Colores</dt>
                  <dd class="col-span-2 text-brand-text">{colores.join(', ')}</dd>
                </div>
                <div class="py-3.5 grid grid-cols-3 gap-4">
                  <dt class="font-semibold text-brand-muted">Presentación</dt>
                  <dd class="col-span-2 text-brand-text">{especificaciones.presentacion}</dd>
                </div>
                <div class="py-3.5 grid grid-cols-3 gap-4">
                  <dt class="font-semibold text-brand-muted">Uso recomendado</dt>
                  <dd class="col-span-2 text-brand-text">{especificaciones.usoRecomendado}</dd>
                </div>
                {
                  especificaciones.ventaMinima && (
                    <div class="py-3.5 grid grid-cols-3 gap-4">
                      <dt class="font-semibold text-brand-muted">Venta mínima</dt>
                      <dd class="col-span-2 text-brand-text">{especificaciones.ventaMinima}</dd>
                    </div>
                  )
                }
              </dl>
            </div>
          </Reveal>
        </div>

        <!-- Descripción larga -->
        <div class="lg:col-span-6">
          <Reveal delay={100}>
            <div class="h-full rounded-3xl bg-white p-6 sm:p-8 border border-brand-border shadow-card flex flex-col justify-between">
              <div>
                <h2 class="font-display text-xl sm:text-2xl font-extrabold text-brand-text mb-4">
                  Descripción detallada
                </h2>
                <p class="text-sm sm:text-base text-brand-muted leading-relaxed mb-6">
                  {descripcionLarga}
                </p>
                <div class="prose prose-sm max-w-none text-brand-muted space-y-3 [&_h3]:font-display [&_h3]:text-base [&_h3]:font-bold [&_h3]:text-brand-text [&_ul]:list-disc [&_ul]:pl-5 [&_li]:my-1.5 [&_strong]:text-brand-text">
                  <Content />
                </div>
              </div>
            </div>
          </Reveal>
        </div>
      </div>

      <!-- 7. CTA Intermedio Mayorista -->
      <Reveal>
        <div class="mt-14 rounded-3xl bg-hero-gradient p-7 sm:p-10 text-white shadow-elevated flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div class="max-w-xl">
            <span class="text-xs font-mono font-bold uppercase tracking-widest text-brand-accent-light">
              Abastecimiento B2B y Mayorista
            </span>
            <h2 class="mt-1 font-display text-2xl sm:text-3xl font-extrabold">
              ¿Comprás por cantidad? Pedinos una cotización personalizada.
            </h2>
            <p class="mt-2 text-sm sm:text-base text-slate-200">
              Atendemos pedidos por bulto para distribuidores, bazares, locales de ropa y empresas con asesoramiento directo.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row w-full md:w-auto gap-3 shrink-0">
            <WhatsAppButton
              label="Cotizar volumen por WhatsApp"
              message={mayoristaWhatsAppMessage}
              location="ficha"
              variant="primary"
              size="md"
            />
            <Button href="/contacto" variant="outline-light" size="md">
              Formulario mayorista
            </Button>
          </div>
        </div>
      </Reveal>

      <!-- 8. Productos relacionados -->
      {
        relatedProducts.length > 0 && (
          <div class="mt-16 pt-12 border-t border-brand-border">
            <div class="flex items-center justify-between gap-4 mb-8">
              <h2 class="font-display text-2xl sm:text-3xl font-extrabold text-brand-text">
                Otros productos de nuestro catálogo
              </h2>
              <a
                href="/catalogo"
                class="font-display text-sm font-bold text-brand-primary hover:text-brand-accent"
              >
                Ver todos →
              </a>
            </div>
            <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
              {relatedProducts.map((relProduct) => (
                <ProductCard product={relProduct} />
              ))}
            </div>
          </div>
        )
      }
    </Container>
  </section>
</ProductLayout>

