---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Stats from '../components/Stats.astro';
import QuoteCTA from '../components/QuoteCTA.astro';
import Reveal from '../components/Reveal.astro';
import { SITE_CONFIG } from '../config/site';

import ganchosImg from '../assets/productos/ganchos-ropa-colores/principal.png';
import colgadorImg from '../assets/productos/colgador-clasico-reforzado/principal.jpg';

const valoresFabrica = [
  {
    titulo: 'Producción enfocada en utilidad real',
    descripcion:
      'Fabricamos artículos plásticos cotidianos que los comercios venden todos los días: ganchos para ropa, colgadores resistentes y llaveros plásticos.',
  },
  {
    titulo: 'Control en cada partida de inyección',
    descripcion:
      'Cuidamos la resistencia estructural, el cierre de los resortes y la terminación superficial de las piezas para entregar un producto parejo y confiable.',
  },
  {
    titulo: 'Trato directo con comercios y mayoristas',
    descripcion:
      'Hablás directo con quienes fabrican el producto. Sin intermediarios innecesarios, con respuestas claras sobre disponibilidad y plazos.',
  },
];
---

<BaseLayout
  title={`Sobre Nosotros | Fábrica Directa ${SITE_CONFIG.nombreEmpresa}`}
  description="Conocé San Pedro Plásticos: fábrica dedicada a la producción de ganchos para ropa, colgadores y artículos plásticos para mayoristas, bazares y comercios."
>
  <!-- Hero Institucional -->
  <section class="bg-hero-gradient text-white py-14 sm:py-20">
    <Container>
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/15 border border-white/20 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-white mb-3">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-accent" aria-hidden="true"></span>
          Identidad industrial y comercial
        </span>
        <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight">
          Fabricamos productos plásticos útiles, resistentes y pensados para vender
        </h1>
        <p class="mt-4 text-base sm:text-lg text-slate-200 leading-relaxed">
          En <strong>{SITE_CONFIG.nombreEmpresa}</strong> trabajamos con un objetivo claro: abastecer a comercios, bazares, distribuidores y clientes con artículos plásticos de calidad confiable y trato directo de fábrica.
        </p>
      </div>
    </Container>
  </section>

  <!-- Historia y Qué fabricamos -->
  <section class="py-16 sm:py-20 bg-white">
    <Container>
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6 space-y-5">
          <Reveal>
            <span class="text-xs font-mono font-bold uppercase tracking-widest text-brand-secondary">
              Nuestra fábrica en {SITE_CONFIG.ciudad}
            </span>
            <h2 class="mt-2 font-display text-2xl sm:text-3xl lg:text-4xl font-extrabold text-brand-text leading-tight">
              Compromiso con la producción nacional y el comercio mayorista
            </h2>
            <p class="mt-4 text-base text-brand-muted leading-relaxed">
              Con <strong>[Años de experiencia]</strong> en el rubro de inyección plástica, en <strong>{SITE_CONFIG.nombreEmpresa}</strong> nos especializamos en desarrollar productos prácticos de alta rotación comercial.
            </p>
            <p class="mt-3 text-base text-brand-muted leading-relaxed">
              Sabemos lo que busca un comerciante o distribuidor cuando incorpora un artículo a su catálogo: buena presentación, resistencia real en el uso diario, precios competitivos para sostener un buen margen y un proveedor que responda rápido.
            </p>
            <div class="mt-6 rounded-2xl bg-brand-bg p-5 border border-brand-border">
              <p class="font-display text-sm font-bold text-brand-primary">
                ¿Qué fabricamos actualmente?
              </p>
              <ul class="mt-2.5 space-y-2 text-sm text-brand-muted">
                <li class="flex items-center gap-2">
                  <span class="h-2 w-2 rounded-full bg-brand-accent" aria-hidden="true"></span>
                  Ganchos y broches plásticos para ropa en presentaciones comerciales.
                </li>
                <li class="flex items-center gap-2">
                  <span class="h-2 w-2 rounded-full bg-brand-accent" aria-hidden="true"></span>
                  Colgadores y perchas plásticas reforzadas para tiendas y hogar.
                </li>
                <li class="flex items-center gap-2">
                  <span class="h-2 w-2 rounded-full bg-brand-accent" aria-hidden="true"></span>
                  Muñecos plásticos tipo llavero para venta mayorista, cotillón y promociones.
                </li>
              </ul>
            </div>
          </Reveal>
        </div>

        <div class="lg:col-span-6">
          <Reveal delay={120}>
            <div class="grid grid-cols-2 gap-4 sm:gap-6">
              <div class="rounded-3xl bg-brand-bg p-6 border border-brand-border shadow-card flex flex-col justify-between">
                <Image
                  src={ganchosImg}
                  alt="Producción de ganchos de ropa plásticos San Pedro Plásticos"
                  width={400}
                  height={320}
                  class="w-full h-44 object-contain"
                />
                <div class="mt-4 pt-3 border-t border-brand-border">
                  <p class="font-display text-sm font-bold text-brand-text">
                    Línea Hogar y Bazar
                  </p>
                  <p class="text-xs text-brand-muted">
                    Ganchos de sujeción firme
                  </p>
                </div>
              </div>

              <div class="rounded-3xl bg-brand-bg p-6 border border-brand-border shadow-card flex flex-col justify-between mt-6 sm:mt-10">
                <Image
                  src={colgadorImg}
                  alt="Producción de colgadores plásticos San Pedro Plásticos"
                  width={400}
                  height={320}
                  class="w-full h-44 object-contain"
                />
                <div class="mt-4 pt-3 border-t border-brand-border">
                  <p class="font-display text-sm font-bold text-brand-text">
                    Línea Indumentaria
                  </p>
                  <p class="text-xs text-brand-muted">
                    Perchas y colgadores durables
                  </p>
                </div>
              </div>
            </div>
          </Reveal>
        </div>
      </div>
    </Container>
  </section>

  <!-- Cómo trabajamos -->
  <section class="py-16 sm:py-20 bg-brand-bg">
    <Container>
      <Reveal>
        <SectionHeading
          eyebrow="Nuestra forma de trabajar"
          title="Calidad industrial con atención cercana"
          description="Construimos relaciones comerciales de largo plazo basadas en la simplicidad operativa y la confiabilidad del producto."
        />
      </Reveal>

      <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
        {
          valoresFabrica.map((valor, idx) => (
            <Reveal delay={idx * 100}>
              <div class="h-full rounded-3xl bg-white p-7 border border-brand-border shadow-card">
                <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-brand-primary font-mono text-sm font-bold text-white">
                  0{idx + 1}
                </span>
                <h3 class="mt-4 font-display text-xl font-bold text-brand-text">
                  {valor.titulo}
                </h3>
                <p class="mt-2.5 text-sm text-brand-muted leading-relaxed">
                  {valor.descripcion}
                </p>
              </div>
            </Reveal>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- Métricas editables -->
  <Stats />

  <!-- CTA a contacto -->
  <QuoteCTA
    title="¿Querés sumar nuestros productos a tu comercio o distribuidora?"
    description="Comunicate directo con fábrica para conocer cantidades mínimas, precios por volumen y opciones de envío."
  />
</BaseLayout>

