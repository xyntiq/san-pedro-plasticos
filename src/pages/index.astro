---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Benefits from '../components/Benefits.astro';
import Container from '../components/Container.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CategoryCard from '../components/CategoryCard.astro';
import ProductCard from '../components/ProductCard.astro';
import Stats from '../components/Stats.astro';
import QuoteCTA from '../components/QuoteCTA.astro';
import Reveal from '../components/Reveal.astro';
import Button from '../components/Button.astro';
import { SITE_CONFIG } from '../config/site';
import { getAllProducts, getFeaturedProducts } from '../utils/products';

import ganchosImg from '../assets/productos/ganchos-ropa-colores/principal.png';
import colgadorImg from '../assets/productos/colgador-clasico-reforzado/principal.jpg';
import munecosImg from '../assets/productos/munecos-llavero-plastico/principal.avif';

const featuredProducts = await getFeaturedProducts(4);
const allProducts = await getAllProducts();

const categoryImages = {
  ganchos: ganchosImg,
  colgadores: colgadorImg,
  llaveros: munecosImg,
} as const;

const processSteps = [
  {
    step: '01',
    title: 'Elegís el producto',
    description:
      'Recorré nuestro catálogo de ganchos, colgadores y llaveros plásticos y seleccioná los modelos para tu negocio.',
  },
  {
    step: '02',
    title: 'Consultás disponibilidad',
    description:
      'Escribinos con un clic por WhatsApp para confirmar stock inmediato y combinaciones de colores disponibles.',
  },
  {
    step: '03',
    title: 'Cotizamos según cantidad',
    description:
      'Te enviamos una cotización clara y personalizada según el volumen de tu compra mayorista o minorista.',
  },
  {
    step: '04',
    title: 'Coordinás entrega o retiro',
    description:
      'Acordamos de forma directa el retiro en fábrica o el despacho hacia tu comercio o distribuidora.',
  },
];

const faqsComerciales = [
  {
    pregunta: '¿Son fábrica directa o revendedores?',
    respuesta:
      'Somos fábrica directa de productos plásticos. Eso nos permite cuidar la calidad de inyección de cada pieza y ofrecer precios competitivos sin intermediarios.',
  },
  {
    pregunta: '¿Realizan ventas por mayor y por menor?',
    respuesta:
      'Sí. Abastecemos tanto a mayoristas, distribuidoras, bazares y tiendas de ropa por bulto o volumen, como a emprendedores y clientes que buscan cantidades menores.',
  },
  {
    pregunta: '¿Cómo solicito lista de precios o cotización?',
    respuesta:
      'Hacé clic en cualquiera de los botones de WhatsApp del sitio o desde la ficha de cada producto. El mensaje ya incluye el nombre y SKU para responderte al instante.',
  },
  {
    pregunta: '¿Se pueden elegir colores o vienen surtidos?',
    respuesta:
      'Contamos con presentaciones en colores surtidos de alta rotación y opciones de colores específicos según disponibilidad de stock o volumen de producción.',
  },
];
---

<BaseLayout
  title="San Pedro Plásticos | Fábrica de Ganchos de Ropa, Colgadores y Llaveros"
  description="Fábrica directa de productos plásticos para comercios, bazares y mayoristas. Ganchos para ropa, perchas reforzadas y muñecos tipo llavero. Cotizá por WhatsApp."
>
  <!-- 1. Hero Section -->
  <Hero />

  <!-- 2. Beneficios -->
  <Benefits />

  <!-- 3. Categorías destacadas -->
  <section class="py-16 sm:py-20 lg:py-24 bg-brand-bg">
    <Container>
      <Reveal>
        <SectionHeading
          eyebrow="Líneas de fabricación"
          title="Categorías pensadas para alta rotación comercial"
          description="Explorá nuestras líneas principales de fabricación plástica para abastecer tu bazar, tienda de ropa o distribuidora."
        />
      </Reveal>

      <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
        {
          SITE_CONFIG.categorias.map((cat, idx) => {
            const count = allProducts.filter((p) => p.data.categoria === cat.slug).length;
            return (
              <Reveal delay={idx * 100}>
                <CategoryCard
                  category={cat}
                  image={categoryImages[cat.slug]}
                  productCount={count}
                />
              </Reveal>
            );
          })
        }
      </div>
    </Container>
  </section>

  <!-- 4. Productos destacados -->
  <section class="py-16 sm:py-20 lg:py-24 bg-white border-t border-brand-border/80">
    <Container>
      <Reveal>
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
          <SectionHeading
            align="left"
            eyebrow="Catálogo directo"
            title="Productos destacados de nuestra fábrica"
            description="Artículos plásticos resistentes, funcionales y listos para exhibir o comercializar por cantidad."
          />
          <div class="shrink-0">
            <Button href="/catalogo" variant="ghost" size="md">
              <span>Ver todo el catálogo</span>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </Button>
          </div>
        </div>
      </Reveal>

      <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          featuredProducts.map((product, idx) => (
            <Reveal delay={idx * 100}>
              <ProductCard product={product} />
            </Reveal>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- 5. Propuesta de valor / Cómo comprar -->
  <section class="py-16 sm:py-20 lg:py-24 bg-brand-bg bg-light-grid bg-[size:32px_32px]">
    <Container>
      <Reveal>
        <SectionHeading
          eyebrow="Proceso ágil y sin vueltas"
          title="Una solución simple para abastecer tu comercio"
          description="Sin carritos complejos ni demoras burocráticas: hablás directo con fábrica y resolvés tu pedido en 4 pasos."
        />
      </Reveal>

      <div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          processSteps.map((item, idx) => (
            <Reveal delay={idx * 90}>
              <div class="relative h-full rounded-2xl bg-white p-6 sm:p-7 border border-brand-border shadow-card flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between mb-4">
                    <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-brand-primary font-mono text-base font-bold text-white shadow-soft">
                      {item.step}
                    </span>
                    {idx < processSteps.length - 1 && (
                      <span class="hidden lg:inline-block text-xs font-mono font-bold uppercase tracking-widest text-brand-secondary/60">
                        Paso {idx + 1} →
                      </span>
                    )}
                  </div>
                  <h3 class="font-display text-lg font-bold text-brand-text">
                    {item.title}
                  </h3>
                  <p class="mt-2 text-sm text-brand-muted leading-relaxed">
                    {item.description}
                  </p>
                </div>
              </div>
            </Reveal>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- 6. Sección de Confianza -->
  <Stats />

  <!-- 7. Respuestas a objeciones frecuentes -->
  <section class="py-16 sm:py-20 bg-brand-bg">
    <Container>
      <Reveal>
        <SectionHeading
          eyebrow="Información comercial clara"
          title="Preguntas frecuentes de comercios y mayoristas"
          description="Todo lo que necesitás saber antes de solicitar tu cotización en San Pedro Plásticos."
        />
      </Reveal>

      <div class="mt-12 mx-auto max-w-4xl grid grid-cols-1 gap-5 md:grid-cols-2">
        {
          faqsComerciales.map((faq, idx) => (
            <Reveal delay={idx * 70}>
              <div class="h-full rounded-2xl bg-white p-6 border border-brand-border shadow-card">
                <h3 class="font-display text-base sm:text-lg font-bold text-brand-primary">
                  {faq.pregunta}
                </h3>
                <p class="mt-2 text-sm text-brand-muted leading-relaxed">
                  {faq.respuesta}
                </p>
              </div>
            </Reveal>
          ))
        }
      </div>
    </Container>
  </section>

  <!--
    8. SECCIÓN DE TESTIMONIOS PREPARADA PARA CLIENTES REALES
    Importante: Se deja estructurada y comentada para activarla únicamente
    cuando se carguen testimonios reales verificados de clientes comerciales,
    respetando la regla de no inventar reseñas falsas.
  -->

  <!-- 9. CTA Final Fuerte -->
  <QuoteCTA />
</BaseLayout>

