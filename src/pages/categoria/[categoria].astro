---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import ProductCard from '../../components/ProductCard.astro';
import QuoteCTA from '../../components/QuoteCTA.astro';
import Reveal from '../../components/Reveal.astro';
import { SITE_CONFIG, type CategoryInfo } from '../../config/site';
import { getProductsByCategory } from '../../utils/products';
import { getBreadcrumbSchema } from '../../utils/seo';

export function getStaticPaths() {
  return SITE_CONFIG.categorias.map((category) => ({
    params: { categoria: category.slug },
    props: { category },
  }));
}

interface Props {
  category: CategoryInfo;
}

const { category } = Astro.props;
const productos = await getProductsByCategory(category.slug);

const breadcrumbItems = [
  { name: 'Inicio', url: '/' },
  { name: 'Catálogo', url: '/catalogo' },
  { name: category.nombre, url: `/categoria/${category.slug}` },
];
---

<BaseLayout
  title={`${category.nombre} Directo de Fábrica | ${SITE_CONFIG.nombreEmpresa}`}
  description={`${category.descripcion} Venta mayorista y minorista. Consultá precios y disponibilidad por WhatsApp.`}
  schemas={[getBreadcrumbSchema(breadcrumbItems)]}
>
  <section class="bg-hero-gradient text-white py-12 sm:py-16">
    <Container>
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="mb-4 text-xs sm:text-sm text-slate-300">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-white">Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/catalogo" class="hover:text-white">Catálogo</a></li>
          <li aria-hidden="true">/</li>
          <li class="font-semibold text-white" aria-current="page">
            {category.nombre}
          </li>
        </ol>
      </nav>

      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/15 border border-white/20 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-white mb-3">
          Línea de fabricación directa
        </span>
        <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight">
          {category.nombre}
        </h1>
        <p class="mt-3 text-base sm:text-lg text-slate-200 leading-relaxed">
          {category.descripcion}
        </p>
      </div>
    </Container>
  </section>

  <section class="py-12 sm:py-16">
    <Container>
      <!-- Selector rápido entre categorías -->
      <div class="mb-8 flex flex-wrap items-center justify-between gap-4 rounded-2xl bg-white p-4 border border-brand-border shadow-card">
        <div class="flex flex-wrap items-center gap-2">
          <a
            href="/catalogo"
            class="rounded-xl px-4 py-2 font-display text-xs sm:text-sm font-semibold bg-brand-bg text-brand-text hover:bg-brand-secondary/15 hover:text-brand-primary transition-colors"
          >
            Todos los productos
          </a>
          {
            SITE_CONFIG.categorias.map((cat) => {
              const active = cat.slug === category.slug;
              return (
                <a
                  href={`/categoria/${cat.slug}`}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'rounded-xl px-4 py-2 font-display text-xs sm:text-sm transition-colors',
                    active
                      ? 'bg-brand-primary text-white font-bold shadow-soft'
                      : 'bg-brand-bg text-brand-text font-semibold hover:bg-brand-secondary/15 hover:text-brand-primary',
                  ]}
                >
                  {cat.nombreCorto}
                </a>
              );
            })
          }
        </div>
        <span class="text-xs font-mono font-semibold text-brand-muted">
          Mostrando {productos.length} {productos.length === 1 ? 'producto' : 'productos'}
        </span>
      </div>

      {
        productos.length > 0 ? (
          <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
            {productos.map((product, idx) => (
              <Reveal delay={idx * 80}>
                <ProductCard product={product} priority={idx < 3} />
              </Reveal>
            ))}
          </div>
        ) : (
          <div class="rounded-3xl bg-white p-10 text-center border border-brand-border shadow-card max-w-xl mx-auto">
            <h2 class="font-display text-xl font-bold text-brand-text">
              Actualmente estamos actualizando los modelos de esta categoría
            </h2>
            <p class="mt-2 text-sm text-brand-muted">
              Consultanos directamente por WhatsApp para conocer disponibilidad de stock o fabricaciones a pedido.
            </p>
          </div>
        )
      }
    </Container>
  </section>

  <QuoteCTA
    title={`¿Querés cotizar ${category.nombre.toLowerCase()} por cantidad?`}
    description="Consultá precios por bulto, colores en stock y condiciones para comercios y distribuidores."
  />
</BaseLayout>

