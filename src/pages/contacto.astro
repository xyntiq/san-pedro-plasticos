---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import ContactForm from '../components/ContactForm.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Reveal from '../components/Reveal.astro';
import { SITE_CONFIG } from '../config/site';
import { buildWhatsAppUrl, getGeneralWhatsAppMessage } from '../utils/whatsapp';

const waDirectUrl = buildWhatsAppUrl(getGeneralWhatsAppMessage());
---

<BaseLayout
  title={`Solicitá tu Cotización | Contacto ${SITE_CONFIG.nombreEmpresa}`}
  description="Contactá a San Pedro Plásticos para cotizar ganchos de ropa, colgadores y llaveros plásticos por mayor o menor. Atención directa por WhatsApp."
>
  <!-- Encabezado de página -->
  <section class="bg-hero-gradient text-white py-12 sm:py-16">
    <Container>
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/15 border border-white/20 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-white mb-3">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-accent" aria-hidden="true"></span>
          Atención directa de fábrica
        </span>
        <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight">
          Solicitá tu cotización
        </h1>
        <p class="mt-3 text-base sm:text-lg text-slate-200 leading-relaxed">
          Escribinos por WhatsApp o completá el formulario con los productos y cantidades que buscás. Respondemos consultas minoristas, de comercios y pedidos mayoristas por volumen.
        </p>
      </div>
    </Container>
  </section>

  <!-- Contenido principal: Datos directos + Formulario -->
  <section class="py-12 sm:py-20">
    <Container>
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-start">
        <!-- Columna izquierda: Contacto directo por WhatsApp y datos -->
        <div class="lg:col-span-5 space-y-6">
          <Reveal>
            <!-- Card destacada de WhatsApp -->
            <div class="rounded-3xl bg-brand-primary p-6 sm:p-8 text-white shadow-elevated space-y-5">
              <div class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-emerald-300">
                <span class="h-2 w-2 rounded-full bg-emerald-400" aria-hidden="true"></span>
                Vía más rápida de respuesta
              </div>
              <h2 class="font-display text-2xl font-extrabold leading-tight">
                ¿Preferís hablar directo por WhatsApp ahora?
              </h2>
              <p class="text-sm text-slate-200 leading-relaxed">
                Iniciá una conversación directa con nuestro sector de ventas para consultar disponibilidad inmediata, colores y precios por bulto.
              </p>
              <WhatsAppButton
                label="Hablar con ventas por WhatsApp"
                preset="mayorista"
                location="contacto"
                variant="whatsapp"
                size="lg"
                fullWidth={true}
              />
            </div>
          </Reveal>

          <!-- Información comercial editable -->
          <Reveal delay={100}>
            <div class="rounded-3xl bg-white p-6 sm:p-8 border border-brand-border shadow-card space-y-6">
              <h2 class="font-display text-xl font-extrabold text-brand-text">
                Datos de contacto comercial
              </h2>

              <ul class="space-y-4 text-sm">
                <li class="flex items-start gap-3.5">
                  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-secondary/10 text-brand-primary">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                  </div>
                  <div>
                    <p class="font-semibold text-brand-text">Teléfono / WhatsApp</p>
                    <p class="text-brand-muted mt-0.5 flex flex-wrap items-center gap-2">
                      <a
                        href={`tel:${SITE_CONFIG.telefonoHref}`}
                        class="font-medium text-brand-primary hover:underline"
                      >
                        {SITE_CONFIG.whatsappDisplay}
                      </a>
                      <span aria-hidden="true">·</span>
                      <a
                        href={waDirectUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-medium text-brand-secondary hover:underline"
                      >
                        Escribir por WhatsApp
                      </a>
                    </p>
                  </div>
                </li>

                <li class="flex items-start gap-3.5">
                  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-secondary/10 text-brand-primary">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  </div>
                  <div>
                    <p class="font-semibold text-brand-text">Correo electrónico</p>
                    <a
                      href={`mailto:${SITE_CONFIG.email}`}
                      class="text-brand-secondary hover:underline mt-0.5 block break-all"
                    >
                      {SITE_CONFIG.email}
                    </a>
                  </div>
                </li>

                <li class="flex items-start gap-3.5">
                  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-secondary/10 text-brand-primary">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </div>
                  <div>
                    <p class="font-semibold text-brand-text">Horarios de atención</p>
                    <p class="text-brand-muted mt-0.5">{SITE_CONFIG.horarios}</p>
                  </div>
                </li>

                <li class="flex items-start gap-3.5">
                  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-secondary/10 text-brand-primary">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                  </div>
                  <div>
                    <p class="font-semibold text-brand-text">Ubicación</p>
                    <p class="text-brand-muted mt-0.5">
                      {SITE_CONFIG.direccion}, {SITE_CONFIG.ciudad}, {SITE_CONFIG.pais}
                    </p>
                  </div>
                </li>
              </ul>
            </div>
          </Reveal>
        </div>

        <!-- Columna derecha: Formulario de cotización -->
        <div class="lg:col-span-7">
          <Reveal delay={80}>
            <ContactForm />
          </Reveal>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

